# Copy to reserve.env and edit for your Pi:
#   cp reserve.env.example reserve.env

RESY_URL=https://resy.com/cities/new-york-ny/venues/eyval?date=2026-05-23&seats=2
RESTAURANT_NAME=Eyval
NTFY_TOPIC=your-ntfy-topic
HEADLESS=true
WAIT_MIN_SECONDS=15
WAIT_MAX_SECONDS=45
BROWSER_RECYCLE_EVERY=15
# Speed: domcontentloaded is much faster than networkidle
PAGE_WAIT_UNTIL=domcontentloaded
PAGE_LOAD_TIMEOUT_MS=30000
SLOT_WAIT_TIMEOUT_MS=10000
BLOCK_MEDIA=true
# Linux: use system Chromium (Pi / Jetson). Override path if needed:
# CHROMIUM_EXECUTABLE=/usr/bin/chromium-browser
# Use Playwright's downloaded browser instead:
# USE_PLAYWRIGHT_BUNDLED_CHROMIUM=true
